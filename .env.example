PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=assinatura_despesas
MONGO_ROOT_USER=appadmin
MONGO_ROOT_PASSWORD=replace-with-a-strong-password-without-url-special-characters
# Docker local usa contas ficticias para demonstracao. Em producao, deixe false por padrao.
DEMO_USERS_ENABLED=true
DEMO_MANAGER_PASSWORD=Gerente123!
DEMO_EMPLOYEE_PASSWORD=Colab123!
# Exact origin of the static frontend. Leave blank for same-origin Docker deployment.
WEB_ORIGIN=
# Optional SMTP notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AssinaDespesas <no-reply@example.com>"
